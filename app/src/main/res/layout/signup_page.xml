<?xml version="1.0" encoding="utf-8"?>



<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login"
    android:orientation="vertical">

    <!-- Header section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="120dp"
            android:layout_height="90dp"
            android:layout_marginStart="-20dp"
            android:layout_marginTop="40dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/logg" />

        <TextView
            android:id="@+id/welcomeback1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginTop="120dp"
            android:fontFamily="@font/poppinsbold"
            android:text="@string/hello"
            android:textColor="#ffffff"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="165dp"
            android:alpha="0.7"
            android:text="@string/sign_up_to_continue"
            android:textColor="#ffffff"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- Scrollable form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="200dp"
        android:fillViewport="true">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFCFC"
            android:elevation="6dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Name -->
                <TextView
                    android:id="@+id/namelabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="Full Name"
                    android:textColor="#232323"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/namebox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:drawableStart="@drawable/name_icon"
                    android:inputType="textPersonName" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="10dp" />

                <!-- Age -->
                <TextView
                    android:id="@+id/dobTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Date of Birth"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:background="@android:drawable/edit_text"
                    android:clickable="true"
                    android:focusable="true"
                    android:inputType="none"/>   <!-- ✅ prevents typing -->


                <TextView
                    android:id="@+id/ageTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Age: "
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:textColor="@android:color/black" />

                <!-- Address -->
                <TextView
                    android:id="@+id/addresslabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="Address"
                    android:textColor="#232323"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/addressbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:drawableStart="@drawable/address_icon"
                    android:inputType="textPostalAddress" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="15dp" />

                <!-- Email -->
                <TextView
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="@string/email"
                    android:textColor="#232323"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/emailbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:drawableStart="@drawable/email_icon"
                    android:inputType="textEmailAddress" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="15dp" />

                <!-- Password -->
                <TextView
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="@string/password"
                    android:textColor="#232323"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/passwordbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:drawableStart="@drawable/password_icon"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="15dp" />

                <!-- Phone -->
                <TextView
                    android:id="@+id/phoneno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="@string/phone_number"
                    android:textColor="#232323"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/phonebox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:drawableStart="@drawable/phone"
                    android:importantForAutofill="no"
                    android:inputType="phone" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="8dp" />

                <!-- Next Button -->
                <Button
                    android:id="@+id/nextbutton1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/next"
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#7C59BA" />

                <!-- Sign-in Option -->
                <TextView
                    android:id="@+id/signinoption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:text="@string/already_have_an_account_sign_in"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</RelativeLayout>
